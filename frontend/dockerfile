# ---------- Stage 1: Build ----------
    FROM node:20-alpine AS build

    WORKDIR /app
    
    # Install deps first (separate layer = better Docker cache)
    COPY package.json yarn.lock* ./
    RUN yarn install --frozen-lockfile
    
    # Build-time env vars (baked into the JS bundle by CRA/Craco - cannot change at runtime)
    ARG REACT_APP_BACKEND_URL
    ARG REACT_APP_GOOGLE_CLIENT_ID
    ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
    ENV REACT_APP_GOOGLE_CLIENT_ID=$REACT_APP_GOOGLE_CLIENT_ID
    
    # NODE_ENV=production ensures Craco's isDevServer check disables visual-edits plugin
    ENV NODE_ENV=production
    
    COPY . .
    RUN yarn build
    
    # ---------- Stage 2: Serve ----------
    FROM nginx:1.27-alpine
    
    RUN rm -rf /usr/share/nginx/html/*
    COPY --from=build /app/build /usr/share/nginx/html
    COPY nginx.conf /etc/nginx/conf.d/default.conf
    
    EXPOSE 80
    CMD ["nginx", "-g", "daemon off;"]