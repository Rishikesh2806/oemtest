FROM python:3.11-slim

WORKDIR /app

# System dependencies:
# - poppler-utils -> required by pdf2image (drawing PDF -> image conversion)
# - ffmpeg        -> required by pydub (WhatsApp voice message audio conversion)
# - libgl1        -> required by PyMuPDF (fitz) / Pillow for image rendering
# - build-essential, libffi-dev -> needed to compile some Python packages (e.g. cryptography, bcrypt)
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    ffmpeg \
    libgl1 \
    build-essential \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (separate layer = cached unless requirements.txt changes)
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy the rest of the backend code
COPY . .

EXPOSE 8000

# Multiple Uvicorn workers since there's no Gunicorn process manager in requirements.txt.
# --reload is intentionally omitted (that's dev-only).
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]